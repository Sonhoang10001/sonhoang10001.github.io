  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-16">

    <!-- HERO SECTION -->
    <section class="glass-panel rounded-3xl p-6 sm:p-10 relative overflow-hidden shadow-2xl border border-slate-700/60">
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-neonCyan/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-pastelPink/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
        
        <!-- Left: Copywriting & Value Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-800/90 border border-neonCyan/30 text-xs font-medium text-neonCyan tracking-wide">
            <span class="w-2 h-2 rounded-full bg-neonCyan animate-ping"></span>
            🎯 Dành Riêng Cho Creator Xinh Đẹp ✨
          </div>
          
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-black leading-tight text-white tracking-tight">
            NGUỒN TRUST ME BRO BUILD 🚀<br/>
            <span class="gradient-text">Dành Riêng Cho Em Miu 🎀</span>
          </h1>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Dù bạn chưa biết gì về linh kiện máy tính, cỗ máy này được thiết kế để bạn <strong class="text-white">chỉ cần bật máy lên và sáng tạo 🎬</strong>. Né trọn vẹn bão giá RAM &amp; Card màn hình, timeline dựng video CapCut tua 4K mượt mà, render ảnh và chạy tính năng AI tự động không lo văng app! 🥳
          </p>

          <!-- 3 Pillars -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4">
              <div class="text-2xl mb-2">⚡</div>
              <h4 class="text-xs font-bold text-slate-200">Intel Quick Sync</h4>
              <p class="text-[11px] text-slate-400 mt-1">Timeline tua mượt như bơ, không lo khựng giật 🎞️</p>
            </div>

            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4">
              <div class="text-2xl mb-2">🪄</div>
              <h4 class="text-xs font-bold text-slate-200">VRAM &amp; AI Studio</h4>
              <p class="text-[11px] text-slate-400 mt-1">Tự động xóa nền, bóp eo, tracking AI siêu tốc 💅</p>
            </div>

            <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4">
              <div class="text-2xl mb-2">🛡️</div>
              <h4 class="text-xs font-bold text-slate-200">Nồi Đồng Cối Đá</h4>
              <p class="text-[11px] text-slate-400 mt-1">Nguồn &amp; tản êm ru &lt; 32dB, bền bỉ 4-5 năm 🤫</p>
            </div>
          </div>
        </div>

        <!-- Right: Khung Hình Ảnh Góc Setup & Tổng Chi Phí Chuẩn Xác -->
        <div class="lg:col-span-5 flex flex-col items-center">
          <div class="w-full relative rounded-3xl overflow-hidden border border-slate-700/80 shadow-2xl group bg-slate-950">
            
            <!-- 1 Hình Ảnh Setup Tinh Tế -->
            <div class="aspect-[4/3] w-full overflow-hidden bg-slate-950">
              <img 
                id="hero-case-img"
                src="https://images.unsplash.com/photo-1587202372775-e229f172b9d7?auto=format&fit=crop&w=1200&q=80" 
                alt="PC Setup View" 
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              />
            </div>
            
            <div class="absolute inset-0 bg-gradient-to-t from-cyberDark via-transparent to-transparent pointer-events-none"></div>

            <!-- Bảng Tổng Chi Phí Dự Toán Chuẩn Xác (23.350.000 VNĐ) -->
