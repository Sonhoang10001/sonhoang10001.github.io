    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-neonCyan via-neonPurple to-pastelPink flex items-center justify-center p-0.5 shadow-glow-cyan">
          <div class="w-full h-full bg-cyberDark rounded-[10px] flex items-center justify-center text-lg">
            ✨
          </div>
        </div>
        <div>
          <span class="font-display font-bold text-lg tracking-wider text-white flex items-center gap-2">
            TITAN <span class="gradient-text font-black">CREATOR</span> 🌸
          </span>
          <span class="text-xs text-slate-400 block tracking-tight">Studio Hardware &amp; Beginner Friendly 2026 🎀</span>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="flex items-center gap-3">
        <a href="#analogy-section" class="hidden md:flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-slate-800/60 hover:bg-slate-800 transition-all">
          <span>💖</span> Ví Dụ Dễ Hiểu
        </a>
        <a href="#quiz-section" class="hidden md:flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-slate-800/60 hover:bg-slate-800 transition-all">
          <span>🧭</span> Chọn Theo Nhu Cầu
        </a>
        <button id="btn-copy-config" class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider bg-gradient-to-r from-neonCyan to-neonPurple text-slate-950 font-bold hover:brightness-110 shadow-glow-cyan transition-all">
          <span>📋</span> <span class="hidden sm:inline">Sao Chép</span> Báo Giá
