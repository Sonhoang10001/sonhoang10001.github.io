            image: "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=500&q=80",
            selected: true,
            why: "Bo mạch chuẩn ATX to nạc, tản nhiệt VRM dày dặn gánh tốt CPU i7 khi render liên tục.",
            impact: "Cung cấp dòng điện ổn định, hỗ trợ Wi-Fi 6E và Bluetooth 5.3 tốc độ cao nhất.",
            market: "Giá niêm yết chuẩn, bảo hành 36 tháng chính hãng."
          },
          {
            id: "p-ssd",
            category: "storage",
            categoryName: "Ổ Cứng Lưu Trữ (SSD)",
            emoji: "👗",
            name: "Kingston KC3000 1TB NVMe PCIe Gen 4x4",
            spec: "Đọc/Ghi 7000MB/s | Có DRAM Cache Riêng Biệt",
            price: 2300000,
            status: "Bình Ổn",
            statusColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/30",
            image: "https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?auto=format&fit=crop&w=500&q=80",
            selected: true,
            why: "Dòng SSD cao cấp nhất phân khúc với tốc độ đọc ghi 7000MB/s và chip DRAM Cache riêng.",
            impact: "Không bao giờ bị tụt tốc độ khi sao chép video dung lượng hàng trăm GB; làm Scratch Disk Photoshop mượt mà tuyệt đối.",
            market: "Giữ giá rất tốt, bảo hành lên tới 5 năm."
          },
          {
            id: "p-cooler",
            category: "peripherals",
            categoryName: "Tản Nhiệt CPU",
            emoji: "❄️",
            name: "Thermalright Aqua Elite 360 ARGB V3",
            spec: "Tản Nước AIO 360mm | 3 Quạt ARGB Hiệu Suất Cao",
            price: 1600000,
            status: "Giá Rất Hời",
            statusColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/30",
            image: "https://images.unsplash.com/photo-1587202372775-e229f172b9d7?auto=format&fit=crop&w=500&q=80",
            selected: true,
            why: "Két nước 360mm diện tích làm mát khổng lồ, kiểm soát triệt để nhiệt độ CPU i7 khi render liên tục.",
            impact: "Giữ CPU luôn dưới 70°C khi ép tải nặng, duy trì xung nhịp cao nhất mà không bị giảm hiệu năng.",
            market: "Giá 1.6 triệu cho một bộ tản nước AIO 360mm là mức giá rất cạnh tranh."
          },
          {
            id: "p-psu",
            category: "peripherals",
            categoryName: "Nguồn Máy Tính (PSU)",
            emoji: "❤️",
            name: "MSI MAG A750GL 750W 80 Plus Gold",
            spec: "Chuẩn PCIe 5.0 & ATX 3.0 | Hiệu Suất 90% Gold",
            price: 2100000,
            status: "Bình Ổn",
            statusColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/30",
            image: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=500&q=80",
            selected: true,
            why: "Chuẩn 80 Plus Gold cao cấp, sẵn sàng cho các thế hệ card đồ họa cao cấp tương lai.",
            impact: "Tiết kiệm điện năng, linh kiện tụ cao cấp của Nhật đảm bảo an toàn tuyệt đối cho dàn máy.",
            market: "Giá thành rất ổn định, dùng bền bỉ 5-7 năm."
          },
          {
            id: "p-case",
            category: "peripherals",
            categoryName: "Vỏ Case Máy Tính",
            emoji: "🎀",
            name: "Montech Air 1000 Premium / Xigmatek Endorphin",
            spec: "Bể Kính / Mặt Lưới Đa Dạng | Kèm Sẵn 4 Quạt ARGB",
            price: 1100000,
            status: "Bình Ổn",
            statusColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/30",
            image: "https://images.unsplash.com/photo-1587202372634-32705e3bf49c?auto=format&fit=crop&w=500&q=80",
            selected: true,
            why: "Không gian rộng rãi, dễ lắp tản nước 360mm, khung thép chắc chắn và kính cường lực sáng bóng.",
            impact: "Lưu thông gió tốt, mang lại vẻ đẹp lộng lẫy cho góc làm việc của bạn.",
            market: "Mức giá hợp lý cho dòng vỏ case cao cấp."
          }
        ]
      }
    };

    /* App State */
    let currentTier = 'budget';
    let currentCategory = 'all';
    let currentHighlightIds = ['b-gpu', 'b-ram', 'b-cpu'];

    /* Currency Formatter */
    function formatVND(amount) {
      return new Intl.NumberFormat('vi-VN').format(amount) + ' VNĐ';
    }

    /* Price Roll Animation */
    function animatePrice(elementId, targetValue) {
      const el = document.getElementById(elementId);
      if (!el) return;
      el.textContent = formatVND(targetValue);
      el.classList.add('scale-105', 'text-neonCyan');
      setTimeout(() => {
        el.classList.remove('scale-105');
      }, 200);
    }

    /* Quiz Option Selection & Dynamic Hardware Highlight */
    function selectQuizNeed(type) {
      const buttons = document.querySelectorAll('.quiz-option');
      buttons.forEach(btn => {
        btn.classList.remove('bg-neonCyan/10', 'border-neonCyan/60', 'shadow-glow-cyan');
        btn.classList.add('bg-slate-900/80', 'border-slate-800');
      });

      const activeBtn = document.getElementById(`quiz-btn-${type}`);
      if (activeBtn) {
        activeBtn.classList.remove('bg-slate-900/80', 'border-slate-800');
        activeBtn.classList.add('bg-neonCyan/10', 'border-neonCyan/60', 'shadow-glow-cyan');
      }

      const descBox = document.getElementById('quiz-recommend-desc');

      if (type === 'light') {
        currentHighlightIds = currentTier === 'budget' ? ['b-cpu', 'b-ssd'] : ['p-cpu', 'p-ssd'];
        descBox.innerHTML = `Với nhu cầu <strong>lướt web &amp; xem phim nhẹ nhàng 🍿</strong>, bạn chỉ cần một chiếc <strong>CPU có iGPU mượt mà 🧠</strong> và <strong>SSD tốc độ cao 👗</strong> là đã quá đủ nhanh rồi!`;
      } else if (type === 'capcut') {
        currentHighlightIds = currentTier === 'budget' ? ['b-gpu', 'b-ram', 'b-cpu'] : ['p-gpu', 'p-ram', 'p-cpu'];
        descBox.innerHTML = `Với nhu cầu <strong>CapCut &amp; Photoshop sống ảo 🎬</strong>, bạn nhất định phải đầu tư vào: <span class="text-neonCyan font-bold">Card đồ họa (VGA RTX 3060 12GB) 💎</span> để gánh filter/AI, <span class="text-pastelPink font-bold">RAM 32GB 🪞</span> để không bị tràn bộ nhớ và <span class="text-neonPurple font-bold">CPU Intel Quick Sync ⚡</span> để tua timeline mượt mà!`;
      } else {
        currentHighlightIds = currentTier === 'budget' ? ['b-cpu', 'b-gpu', 'b-ram', 'b-cooler'] : ['p-cpu', 'p-gpu', 'p-ram', 'p-cooler'];
        descBox.innerHTML = `Với nhu cầu <strong>Đồ Họa Nặng &amp; 3D Render 💼</strong>, bạn nên cân nhắc chuyển sang <strong class="text-neonCyan font-bold">Bản Hiệu Năng Cao (&lt; 35 Tr) 🔥</strong> để có CPU i7 20 nhân và tản nước AIO 360mm giúp máy mát mẻ khi render liên tục!`;
      }

      renderComponents();
    }

    /* Render Components Grid */
    function renderComponents() {
      const container = document.getElementById('components-grid');
      const tierData = BUILD_DATA[currentTier];
      
      const filteredItems = tierData.items.filter(item => {
        if (currentCategory === 'all') return true;
        return item.category === currentCategory;
      });

      container.innerHTML = filteredItems.map(item => {
        const isHighlighted = currentHighlightIds.includes(item.id);
        return `
          <div class="glass-panel glass-card-hover rounded-2xl p-4 flex flex-col justify-between border ${isHighlighted ? 'recommended-glow' : 'border-slate-800'} relative group ${item.selected ? 'opacity-100' : 'opacity-50'}">
            
            ${isHighlighted ? `
              <div class="absolute -top-3 left-4 z-10 px-2.5 py-0.5 rounded-full bg-gradient-to-r from-neonCyan to-neonPurple text-slate-950 text-[10px] font-black uppercase tracking-wider shadow-lg flex items-center gap-1">
                <span>✨</span> Khuyên Dùng Cho Nhu Cầu Này
              </div>
            ` : ''}

            <!-- Top Row: Checkbox & Status -->
            <div>
              <div class="flex items-center justify-between gap-2 mb-3 ${isHighlighted ? 'mt-2' : ''}">
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input 
                    type="checkbox" 
                    ${item.selected ? 'checked' : ''} 
                    onchange="toggleItemSelection('${item.id}')"
                    class="w-4 h-4 rounded text-neonCyan bg-slate-900 border-slate-700 focus:ring-0 cursor-pointer accent-neonCyan"
                  />
                  <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                    <span>${item.emoji}</span> ${item.categoryName}
                  </span>
                </label>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full border ${item.statusColor}">
                  ${item.status}
                </span>
              </div>

              <!-- Product Image -->
              <div class="relative w-full h-36 rounded-xl overflow-hidden mb-3 bg-slate-900 border border-slate-800">
                <img 
                  src="${item.image}" 
                  alt="${item.name}" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://placehold.co/400x300/111726/00F2FE?text=${encodeURIComponent(item.categoryName)}'"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-cyberDark/90 via-transparent to-transparent"></div>
                <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between">
                  <span class="text-xs font-bold text-white font-display truncate">${item.spec}</span>
                </div>
              </div>

              <!-- Title & Impact Description -->
              <h3 class="text-sm font-bold text-white leading-snug line-clamp-2 min-h-[2.5rem]">${item.name}</h3>
              <p class="text-xs text-slate-400 mt-1 line-clamp-2 leading-relaxed">${item.impact}</p>
            </div>

            <!-- Bottom Row: Price & Deep-Dive Info Button -->
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase text-slate-500 block">Đơn giá</span>
                <span class="text-sm font-extrabold text-neonCyan font-display">${formatVND(item.price)}</span>
              </div>

              <button 
                onclick="openModal('${item.id}')"
                class="px-2.5 py-1.5 rounded-lg bg-slate-800/80 hover:bg-neonCyan hover:text-slate-950 text-slate-300 text-xs font-semibold flex items-center gap-1.5 transition-all">
                <span>🔍</span> Chi Tiết
              </button>
            </div>

          </div>
        `;
      }).join('');

      lucide.createIcons();
      updateCalculations();
    }

    /* Toggle Item Selection */
    function toggleItemSelection(itemId) {
      const tierData = BUILD_DATA[currentTier];
      const item = tierData.items.find(i => i.id === itemId);
      if (item) {
        item.selected = !item.selected;
        renderComponents();
      }
    }

    /* Recalculate Total Cost */
    function updateCalculations() {
      const tierData = BUILD_DATA[currentTier];
      const selectedItems = tierData.items.filter(i => i.selected);
      const total = selectedItems.reduce((sum, i) => sum + i.price, 0);

      animatePrice('live-total-price', total);

      const countEl = document.getElementById('selected-parts-count');
      if (countEl) {
        countEl.textContent = `📦 ${selectedItems.length} / ${tierData.items.length} Món`;
      }
    }

    /* Switch Preset Tier */
    function switchTier(tierKey) {
      currentTier = tierKey;
      
      const tabBudget = document.getElementById('tab-budget');
      const tabPro = document.getElementById('tab-pro');
      const heroImg = document.getElementById('hero-case-img');

      if (tierKey === 'budget') {
        tabBudget.className = "flex-1 md:flex-initial px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center justify-center gap-2 bg-gradient-to-r from-neonCyan to-neonPurple text-slate-950 font-bold shadow-glow-cyan";
        tabPro.className = "flex-1 md:flex-initial px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-400 hover:text-white transition-all flex items-center justify-center gap-2 hover:bg-slate-800/60";
        heroImg.src = BUILD_DATA.budget.image;
        currentHighlightIds = ['b-gpu', 'b-ram', 'b-cpu'];
      } else {
        tabPro.className = "flex-1 md:flex-initial px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center justify-center gap-2 bg-gradient-to-r from-neonCyan to-neonPurple text-slate-950 font-bold shadow-glow-cyan";
        tabBudget.className = "flex-1 md:flex-initial px-5 py-2.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-400 hover:text-white transition-all flex items-center justify-center gap-2 hover:bg-slate-800/60";
        heroImg.src = BUILD_DATA.pro.image;
        currentHighlightIds = ['p-gpu', 'p-ram', 'p-cpu'];
      }

      renderComponents();
    }

    /* Filter Components by Category */
    function filterCategory(categoryKey, event) {
      currentCategory = categoryKey;
      
      const buttons = document.querySelectorAll('.cat-btn');
      buttons.forEach(btn => {
        btn.classList.remove('bg-neonCyan/15', 'text-neonCyan', 'border-neonCyan/40');
        btn.classList.add('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
      });

      if (event && event.target) {
        const targetBtn = event.target.closest('.cat-btn');
        if (targetBtn) {
          targetBtn.classList.remove('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
          targetBtn.classList.add('bg-neonCyan/15', 'text-neonCyan', 'border-neonCyan/40');
        }
      }

      renderComponents();
    }

    /* Open Modal Details */
    function openModal(itemId) {
      const tierData = BUILD_DATA[currentTier];
      const item = tierData.items.find(i => i.id === itemId);
      if (!item) return;

      document.getElementById('modal-emoji').textContent = item.emoji || "💻";
      document.getElementById('modal-category').textContent = item.categoryName;
      document.getElementById('modal-title').textContent = item.name;
      document.getElementById('modal-price').textContent = formatVND(item.price);
      
      const statusBadge = document.getElementById('modal-status-badge');
      statusBadge.textContent = item.status;
      statusBadge.className = `text-[11px] px-2.5 py-0.5 rounded-full border font-semibold ${item.statusColor}`;

      document.getElementById('modal-why').textContent = item.why;
      document.getElementById('modal-impact').textContent = item.impact;
      document.getElementById('modal-market').textContent = item.market;

      const modal = document.getElementById('tech-modal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      lucide.createIcons();
    }

    /* Close Modal */
    function closeModal() {
      const modal = document.getElementById('tech-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }

    /* Close modal with ESC key */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    /* Copy Configuration to Clipboard */
    document.getElementById('btn-copy-config').addEventListener('click', () => {
      const tierData = BUILD_DATA[currentTier];
      const selectedItems = tierData.items.filter(i => i.selected);
      const total = selectedItems.reduce((sum, i) => sum + i.price, 0);

      let text = `=== 🌸 ${tierData.name.toUpperCase()} 🌸 ===\n`;
      text += `Dành cho CapCut, Photoshop & Creator Xinh Đẹp ✨\n\n`;
      selectedItems.forEach((item, index) => {
        text += `${index + 1}. [${item.emoji} ${item.categoryName}] ${item.name} (${item.spec}) - ${formatVND(item.price)}\n`;
      });
      text += `\n💰 TỔNG CỘNG: ${formatVND(total)}\n`;
      text += `🛡️ Bảo hành chính hãng 36 tháng. Đã bao gồm Wi-Fi 6E & Bluetooth không dây 🎧`;

      const tempTextarea = document.createElement('textarea');
      tempTextarea.value = text;
      document.body.appendChild(tempTextarea);
      tempTextarea.select();
      document.execCommand('copy');
      document.body.removeChild(tempTextarea);

      // Show Toast Notification
      const toast = document.getElementById('toast');
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3200);
    });

    /* Initialize on Page Load */
    window.addEventListener('DOMContentLoaded', () => {
      renderComponents();
      lucide.createIcons();
    });
  </script>
</body>
</html>
